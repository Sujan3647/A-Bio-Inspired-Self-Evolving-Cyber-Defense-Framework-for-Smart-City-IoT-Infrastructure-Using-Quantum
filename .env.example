# ============================================================
# ImmunoGrid — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Application
APP_NAME=ImmunoGrid
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key

# Database — PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=immunogrid
POSTGRES_USER=immunogrid_user
POSTGRES_PASSWORD=your_postgres_password

# Database — MongoDB
MONGO_URI=mongodb://localhost:27017/immunogrid

# Database — Redis
REDIS_URL=redis://localhost:6379

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com
AWS_S3_BUCKET=immunogrid-data

# JWT Auth
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=immunogrid
MQTT_PASSWORD=mqtt_password

# Blockchain — Hyperledger Fabric
FABRIC_NETWORK_NAME=immunogrid-network
FABRIC_CHANNEL_NAME=immunogrid-channel
FABRIC_CHAINCODE_NAME=immunogrid-chaincode
FABRIC_ORG_NAME=ImmunoGridOrg
FABRIC_PEER_ENDPOINT=localhost:7051

# Quantum Engine
QISKIT_IBM_TOKEN=your_ibm_quantum_token
QUANTUM_BACKEND=aer_simulator

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# SMS Alerts
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
